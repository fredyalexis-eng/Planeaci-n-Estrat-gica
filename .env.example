# ==============================================================================
# ANI STRATEGY LAB — Configuración segura del servidor y Agente Estratégico IA
# Copie este archivo a `.env` (ignorado por Git) y configure sus credenciales.
# NUNCA publique claves reales en el repositorio ni en el código del navegador.
# ==============================================================================

# Puerto e interfaz del servidor (0.0.0.0 para contenedores y vista previa)
PORT=3000
HOST=0.0.0.0

# Orígenes CORS permitidos cuando el frontend corre en GitHub Pages u otro dominio
# Separe múltiples orígenes por coma. Use vacío para permitir mismo origen y vistas previas.
ALLOWED_ORIGINS=https://fredyalexis-eng.github.io

# ------------------------------------------------------------------------------
# PROVEEDOR DE IA — ARENA API (Preferencia principal configurada)
# Documentación oficial: https://platform.arena.ai/docs/api
# Panel de claves:       https://platform.arena.ai/dashboard/keys
# Catálogo de modelos:   https://platform.arena.ai/dashboard/models
# ------------------------------------------------------------------------------
AI_PROVIDER=arena

# Clave secreta generada en https://platform.arena.ai/dashboard/keys
ARENA_API_KEY=

# Formato del protocolo soportado por Arena API:
#   - openai    -> usa https://api.arena.ai/v1  (POST /v1/chat/completions, GET /v1/models)
#   - anthropic -> usa https://api.arena.ai     (POST /v1/messages, GET /v1/models)
ARENA_API_FORMAT=openai

# URL base oficial de Arena API (ajustar si usa ARENA_API_FORMAT=anthropic -> https://api.arena.ai)
ARENA_BASE_URL=https://api.arena.ai/v1

# ID del modelo habilitado en su workspace de Arena API (consulte GET /v1/models).
# Nota oficial de Arena: `coding-router-preview` está optimizado para herramientas de código
# (Claude Code, Codex, OpenCode). Para análisis estratégico institucional se recomienda
# indicar un modelo directo habilitado en su cuenta (requiere saldo prepago o promocional
# "all models" en platform.arena.ai). Si se deja vacío, el verificador listará los modelos
# disponibles para su clave y usará `coding-router-preview` solo si se solicita explícitamente.
ARENA_MODEL=

# Límites de seguridad y control de costos por consulta (evita HTTP 422 billing_unbounded_request)
ARENA_MAX_OUTPUT_TOKENS=2048
ARENA_TIMEOUT_MS=45000
ARENA_TEMPERATURE=0.2

# Límite de solicitudes por minuto por IP en el backend de ANI Strategy Lab
RATE_LIMIT_RPM=30
